{
  "expo": {
    "name": "mobile",
    "slug": "lifemate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.chandra8120.lifemate",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-notifications",
      "expo-audio",
      "expo-sharing",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow LifeMate to use the microphone to fill forms by voice.",
          "speechRecognitionPermission": "Allow LifeMate to use speech recognition to fill forms by voice.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "eb08ba46-b741-49ee-8698-8647e1f9be2c"
      }
    },
    "owner": "chandra8120"
  }
}
