{
  "expo": {
    "name": "mobile",
    "slug": "life",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.chandra8120.lifemate",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/reminder_alert.wav",
            "./assets/sounds/sound_bell.mp3",
            "./assets/sounds/sound_bells.mp3",
            "./assets/sounds/sound_pop.mp3",
            "./assets/sounds/sound_confirm.mp3",
            "./assets/sounds/sound_positive.mp3",
            "./assets/sounds/sound_doorbell.mp3",
            "./assets/sounds/sound_digital.mp3",
            "./assets/sounds/sound_magic.mp3",
            "./assets/sounds/sound_clear.mp3",
            "./assets/sounds/sound_urgent.mp3"
          ]
        }
      ],
      "expo-audio",
      "expo-sharing",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow LifeMate to use the microphone to fill forms by voice.",
          "speechRecognitionPermission": "Allow LifeMate to use speech recognition to fill forms by voice.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow LifeMate to access your contacts to find friends already using the app."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2b237239-57c2-4d0b-9599-6cb359484e88"
      }
    },
    "owner": "lifemate123"
  }
}
