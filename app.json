{
  "expo": {
    "name": "mobile",
    "slug": "lifemate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.chandra8120.lifemate",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.CAMERA",
        "android.permission.BLUETOOTH"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow LifeMate AI to access your microphone to record voice messages."
        }
      ],
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow LifeMate AI to access your photos to share images in chat.",
          "cameraPermission": "Allow LifeMate AI to access your camera to share photos in chat."
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow LifeMate to access your camera for video calls.",
          "microphonePermission": "Allow LifeMate to access your microphone for voice and video calls."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "eb08ba46-b741-49ee-8698-8647e1f9be2c"
      }
    },
    "owner": "chandra8120"
  }
}
